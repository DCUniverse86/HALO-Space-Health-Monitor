#HALO - Environment Configuration Example
#Copy the relevant variables into local .env file and set the values.
#Never commit actual API keys or secrets.

#Frontend - Vite
#Used by the React frontend to reach FastAPI
VITE_API_BASE_URL=http://127.0.0.1:8000

#Backend - FastAPI
HALO_API_HOST=127.0.0.1
HALO_API_PORT=8000

#Backend - Google Gemeni
#Donte will confirm the actual variable name and setup.
#GEMINI_API_KEY=your_key_here